# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node (shell/)
node_modules/
.vite/
shell/dist/
# tsc incremental build state — regenerated on every build, and it changes on
# every build, so tracking it makes every shell commit look like a diff.
*.tsbuildinfo

# tendon runtime state
.tendon/
episodes/
checkpoints/
*.safetensors
*.ckpt
outputs/
# Example output — regenerated by running the example, not committed.
results/
wandb/
mlruns/

# Data — episodes are large; they live on the Hub, not in git
*.parquet
*.mp4
*.hdf5

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
!.env.example
